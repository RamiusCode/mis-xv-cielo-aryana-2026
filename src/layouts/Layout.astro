---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;

/*
   ── La vista previa al compartir el link ──────────────────────
   miniatura.png es la portada horizontal preparada para la vista previa
   de WhatsApp. Se publica con una URL absoluta tomada de Astro.site.

   La ruta se arma con Astro.site (la dirección del config): WhatsApp no
   sigue rutas relativas, necesita la dirección completa.

   Se omite og:description y se usa un título invisible para que la
   vista previa muestre la imagen sin texto añadido.
*/
const miniatura = new URL('/imagenes/miniatura.png', Astro.site).href;
const paginaActual = new URL(Astro.url.pathname, Astro.site).href;
/*
   Al compartir el link se quiere SOLO la imagen, sin texto. WhatsApp
   siempre pone un título y, si falta og:title, usa el <title> de la
   pestaña. Por eso el título de la vista previa es un carácter en blanco
   (U+2800): la tarjeta queda con la imagen sola. La pestaña del navegador
   sigue con su título normal.
*/
const tituloPreview = '⠀';
const textoImagen = 'Portada de los XV años de Cielo Aryana';
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/png" href="/imagenes/corona.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- ── Vista previa al compartir el link ─────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloPreview} />
    <meta property="og:url" content={paginaActual} />
    <meta property="og:image" content={miniatura} />
    <meta property="og:image:secure_url" content={miniatura} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={textoImagen} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPreview} />
    <meta name="twitter:image" content={miniatura} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fuentes de la portada y familias de texto de la invitación -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Great+Vibes&family=Sacramento&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro y evitar dark mode del navegador */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        /* Fuera de la columna móvil (tablet / PC) */
        background-color: #e9e4dd;
      }

      /* La invitación SIEMPRE se ve como celular: columna centrada */
      main {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        min-height: 100vh;
        /*
           Papel blanco liso de punta a punta. Antes acá iba la acuarela
           (fondo.webp); se sacó a pedido.

           El blanco va declarado como imagen y no como color: el modo
           oscuro forzado de algunos celulares oscurece los colores pero
           respeta las imágenes, así que escrito así la hoja no se vuelve
           gris ni negra.
        */
        background-image: linear-gradient(#ffffff, #ffffff);
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-size: cover;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
