<section class="dedicatori" aria-label="Dedicatoria">
    <div class="puntos-entrada puntos-izquierda" aria-hidden="true">
        <img class="puntos puntos-arriba" src="/imagenes/puntos.png" alt="" />
    </div>
    <div class="marco-texto">
        <p class="saludo">HEY UPPER EAST SIDERS...</p>
        <p class="mensaje">
            HA LLEGADO EL MOMENTO<br />
            DE CELEBRAR MIS XV.<br />
            ¿ESTÁS LISTO PARA LA<br />
            NOCHE MÁS EXCLUSIVA?
        </p>
    </div>
    <div class="puntos-entrada puntos-derecha" aria-hidden="true">
        <img class="puntos puntos-abajo" src="/imagenes/puntos.png" alt="" />
    </div>
</section>

<style>
    .dedicatori {
        position: relative;
        z-index: 2;
        isolation: isolate;
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 15rem;
        overflow: hidden;
        padding: 2.4rem 10%;
        background: #050505;
        color: #e9e5e4;
    }

    .marco-texto {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 22rem;
        padding: 0.8rem 0.6rem 0.75rem;
        border: 1px solid rgba(245, 242, 238, 0.9);
        text-align: center;
    }

    .saludo,
    .mensaje {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(0.82rem, 4vw, 1.05rem);
        font-weight: 400;
        letter-spacing: 0.055em;
        line-height: 1.28;
        text-transform: uppercase;
    }

    .saludo {
        margin-bottom: 0.8rem;
        white-space: nowrap;
    }

    .mensaje {
        line-height: 1.2;
    }

    .puntos-entrada {
        position: absolute;
        z-index: 0;
        width: 6rem;
        height: 10rem;
        pointer-events: none;
    }

    .puntos-izquierda {
        top: 0;
        left: 0;
    }

    .puntos-derecha {
        right: 0;
        bottom: 0;
    }

    .puntos {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0.95;
    }

    .puntos-arriba {
        object-position: right top;
        transform: rotateY(180deg);
    }

    .puntos-abajo {
        object-position: right top;
    }

    @media (min-width: 700px) {
        .dedicatori {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.querySelector(".dedicatori");
        const marco = seccion?.querySelector(".marco-texto");
        const textos = seccion?.querySelectorAll(".saludo, .mensaje");
        const izquierda = seccion?.querySelector(".puntos-izquierda");
        const derecha = seccion?.querySelector(".puntos-derecha");
        if (!seccion || !marco || !textos?.length || !izquierda || !derecha || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const entrada = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 82%",
                toggleActions: "play none none reset",
            },
        });
        entrada.fromTo(izquierda, { opacity: 0, x: -64 }, { opacity: 1, x: 0, duration: 1, ease: "power3.out" }, 0);
        entrada.fromTo(derecha, { opacity: 0, x: 64 }, { opacity: 1, x: 0, duration: 1, ease: "power3.out" }, 0);
        entrada.fromTo(marco, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.65, ease: "power2.out" }, 0.22);
        entrada.fromTo(textos, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.22, ease: "power2.out" }, 0.4);
    });
</script>
