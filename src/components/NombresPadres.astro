<section id="padres" class="padres" aria-label="Con la bendición de Dios y mis padres">
    <div class="tarjeta" id="tarjeta-padres">
        <p class="introduccion">Con la bendición de Dios y mis padres</p>

        <div class="corazon" aria-hidden="true">
            <b>♥</b>
        </div>

        <div class="nombres">
            <p class="nombre">Dennys Cruz</p>
            <p class="nombre">Claudia Plata</p>
        </div>
    </div>
</section>

<style>
    .padres {
        position: relative;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 15rem;
        padding: 2.4rem 8%;
        overflow: hidden;
        background: #fff;
        color: #171518;
    }

    .tarjeta {
        position: relative;
        width: 100%;
        max-width: 22rem;
        padding: 1.25rem 1rem 1.1rem;
        border: 1px solid #b72d43;
        background: linear-gradient(145deg, #fff 0%, #fff 72%, #fbf5f6 100%);
        text-align: center;
    }

    .introduccion {
        margin: 0;
        color: #252125;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(0.82rem, 4vw, 1.05rem);
        font-style: normal;
        font-weight: 400;
        letter-spacing: 0.055em;
        line-height: 1.28;
        text-transform: uppercase;
    }

    .corazon {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin: 0.65rem auto 0.55rem;
        color: #b72d43;
    }

    .corazon b {
        font: 1.2rem/1 Georgia, serif;
    }

    .nombres {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .nombre {
        margin: 0;
        color: #171518;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(0.82rem, 4vw, 1.05rem);
        font-weight: 600;
        letter-spacing: 0.055em;
        line-height: 1.28;
        text-transform: uppercase;
    }

    @media (min-width: 700px) {
        .padres {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("padres");
        const tarjeta = document.getElementById("tarjeta-padres");
        const partes = seccion?.querySelectorAll(".introduccion, .corazon, .nombre");
        if (!seccion || !tarjeta || !partes?.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        gsap.fromTo(
            tarjeta,
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 0.9,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: seccion,
                    start: "top 82%",
                    toggleActions: "play none none reset",
                },
            },
        );
        gsap.fromTo(
            partes,
            { opacity: 0, y: 9 },
            {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.14,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: seccion,
                    start: "top 82%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
