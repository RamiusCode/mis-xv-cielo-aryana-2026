---
import RamaMarco from "./RamaMarco.astro";
// Padres: negro y plateado, con detalles rojos y entrada letra por letra.
const introduccion = "Con la bendición de Dios y mis padres";
const nombres = ["Dr. Dennys Cruz", "Claudia Plata"];

// Parte un texto en palabras y letras (las palabras no se cortan al bajar de renglón)
const palabras = (texto: string) => texto.split(" ").map((p) => Array.from(p));

// Destellos de las esquinas: los mismos de la dedicatoria
const esquinaArriba = [
    { x: 8, y: 8, t: 1.5 },
    { x: 34, y: 20, t: 0.9 },
    { x: 18, y: 42, t: 1.1 },
    { x: 52, y: 6, t: 0.7 },
    { x: 6, y: 66, t: 0.7 },
    { x: 46, y: 50, t: 0.6 },
    { x: 66, y: 32, t: 0.8 },
];
const esquinaAbajo = [
    { x: 90, y: 90, t: 1.5 },
    { x: 64, y: 78, t: 0.9 },
    { x: 80, y: 56, t: 1.1 },
    { x: 46, y: 92, t: 0.7 },
    { x: 92, y: 32, t: 0.7 },
    { x: 52, y: 48, t: 0.6 },
    { x: 32, y: 66, t: 0.8 },
];
---

<section id="padres" class="padres" aria-label="Con la bendición de Dios y mis padres">
    <img class="fondo-estatua" src="/imagenes/fondo4.png" alt="" aria-hidden="true" loading="lazy" />

    <div class="destellos destellos-arriba" aria-hidden="true">
        {esquinaArriba.map((d) => <span class="destello" style={`left:${d.x}%;top:${d.y}%;--t:${d.t}`} />)}
    </div>
    <div class="destellos destellos-abajo" aria-hidden="true">
        {esquinaAbajo.map((d) => <span class="destello" style={`left:${d.x}%;top:${d.y}%;--t:${d.t}`} />)}
    </div>

    <div class="tarjeta" id="tarjeta-padres">
        <span class="rombo" aria-hidden="true"></span>

        <p class="introduccion" aria-label={introduccion}>
            {
                palabras(introduccion).map((palabra) => (
                    <span class="palabra" aria-hidden="true">
                        {palabra.map((l) => (
                            <span class="letra">{l}</span>
                        ))}
                    </span>
                ))
            }
        </p>

        <div class="corazon" aria-hidden="true">
            <span class="linea izquierda"></span>
            <b>♥</b>
            <span class="linea derecha"></span>
        </div>

        <div class="nombres">
            {
                nombres.map((nombre) => (
                    <p class="nombre" aria-label={nombre}>
                        {palabras(nombre).map((palabra) => (
                            <span class="palabra" aria-hidden="true">
                                {palabra.map((l) => (
                                    <span class="letra">{l}</span>
                                ))}
                            </span>
                        ))}
                    </p>
                ))
            }
        </div>
        <RamaMarco color="#c9ccd2" fondo="#050505" />
    </div>
</section>

<style>
    .padres {
        position: relative;
        z-index: 2;
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 15rem;
        padding: 2.4rem 8%;
        overflow: hidden;
        background-color: #050505;
        color: #f1f2f4;
    }

    /* Ciudad dibujada en líneas blancas, apenas visible, como fondo */
    .fondo-estatua {
        position: absolute;
        z-index: 0;
        inset: -6% 0;
        width: 100%;
        height: 112%;
        object-fit: cover;
        object-position: center;
        filter: invert(1);
        opacity: 0.25;
        pointer-events: none;
    }

    .destellos {
        position: absolute;
        z-index: 0;
        width: 6.5rem;
        height: 10rem;
        pointer-events: none;
        filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.65));
    }

    .destellos-arriba {
        top: 0;
        left: 0;
    }

    .destellos-abajo {
        right: 0;
        bottom: 0;
    }

    .destello {
        position: absolute;
        width: calc(0.95rem * var(--t));
        aspect-ratio: 1;
        translate: -50% -50%;
        background: #fff;
        clip-path: polygon(50% 0, 59% 41%, 100% 50%, 60% 59%, 50% 100%, 41% 59%, 0 50%, 41% 41%);
        opacity: 0.9;
    }

    .tarjeta {
        z-index: 1;
        position: relative;
        background: rgba(5, 5, 5, 0.55);
        width: 100%;
        max-width: 22rem;
        padding: 0.8rem 0.6rem 0.75rem;
        border: 1px solid #c9ccd2;
        text-align: center;
    }

    /* Rombo sobre el borde de arriba, igual que en la dedicatoria */
    .rombo {
        position: absolute;
        top: 0;
        left: 50%;
        width: 0.5rem;
        aspect-ratio: 1;
        translate: -50% -50%;
        rotate: 45deg;
        background: #fff;
        box-shadow: 0 0 0 3px #050505;
    }

    .introduccion,
    .nombre {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(0.82rem, 4vw, 1.05rem);
        letter-spacing: 0.055em;
        line-height: 1.28;
        text-transform: uppercase;
    }

    .introduccion {
        font-weight: 400;
        color: #e4e6ea;
    }

    .nombre {
        font-weight: 600;
        color: #fff;
    }

    .palabra {
        display: inline-block;
        white-space: nowrap;
        margin-inline: 0.15em;
    }

    /* Letras con brillo plateado */
    .letra {
        display: inline-block;
        text-shadow:
            0 0 4px rgba(255, 255, 255, 0.7),
            0 0 10px rgba(201, 204, 210, 0.5);
    }

    .corazon {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        margin: 0.65rem auto 0.55rem;
        width: 70%;
    }

    .corazon b {
        color: #d5283f;
        font: 1.2rem/1 Georgia, serif;
    }

    .linea {
        flex: 1;
        height: 1px;
        background: #c9ccd2;
    }

    .linea.izquierda {
        transform-origin: right center;
    }

    .linea.derecha {
        transform-origin: left center;
    }

    .nombres {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    @media (min-width: 700px) {
        .padres {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("padres");
        const tarjeta = document.getElementById("tarjeta-padres");
        if (!seccion || !tarjeta || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const rombo = tarjeta.querySelector(".rombo");
        const destellos = seccion.querySelectorAll(".destello");
        const estatua = seccion.querySelector(".fondo-estatua");
        const lineas = tarjeta.querySelectorAll(".linea");
        const corazon = tarjeta.querySelector(".corazon b");
        const intro = tarjeta.querySelectorAll(".introduccion .letra");
        const nombres = tarjeta.querySelectorAll(".nombre");

        // Los destellos titilan solos, cada uno a su ritmo
        let titilando = false;
        const titilar = () => {
            if (titilando) return;
            titilando = true;
            destellos.forEach((d) => {
                gsap.timeline({ repeat: -1, delay: gsap.utils.random(0, 2), repeatDelay: gsap.utils.random(0.2, 1.4) })
                    .to(d, { scale: 1.25, opacity: 1, rotate: 20, duration: 0.7, ease: "sine.inOut" })
                    .to(d, { scale: 0.35, opacity: 0.25, rotate: 0, duration: 0.9, ease: "sine.inOut" });
            });
        };

        // La estatua se mueve un poco más lento que el resto al bajar
        if (estatua) {
            gsap.fromTo(
                estatua,
                { yPercent: -3 },
                { yPercent: 3, ease: "none", scrollTrigger: { trigger: seccion, start: "top bottom", end: "bottom top", scrub: true } }
            );
        }

        const entrada = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 82%",
                toggleActions: "play none none reset",
            },
            onStart: titilar,
        });

        if (estatua) entrada.fromTo(estatua, { opacity: 0 }, { opacity: 0.25, duration: 1.6, ease: "power2.out" }, 0);
        entrada.fromTo(destellos, { opacity: 0, scale: 0 }, { opacity: 0.9, scale: 1, duration: 0.8, ease: "back.out(2)", stagger: 0.08 }, 0.2);
        entrada.fromTo(tarjeta, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.7, ease: "power2.out" }, 0);
        entrada.fromTo(rombo, { scale: 0 }, { scale: 1, duration: 0.6, ease: "back.out(2.5)" }, 0.5);

        // Introducción: letras desde la izquierda
        entrada.fromTo(intro, { opacity: 0, x: -30 }, { opacity: 1, x: 0, duration: 0.9, ease: "power2.out", stagger: 0.03 }, 0.6);

        // Líneas que se abren y corazón que aparece con un latido
        entrada.fromTo(lineas, { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "power2.out" }, 1.5);
        if (corazon) {
            entrada.fromTo(corazon, { scale: 0 }, { scale: 1, duration: 0.7, ease: "back.out(3)" }, 1.55);
        }

        // Nombres: el primero desde la izquierda, el segundo desde la derecha
        nombres.forEach((nombre, i) => {
            entrada.fromTo(
                nombre.querySelectorAll(".letra"),
                { opacity: 0, x: i % 2 === 0 ? -34 : 34 },
                { opacity: 1, x: 0, duration: 0.9, ease: "power2.out", stagger: 0.05 },
                1.8 + i * 0.4
            );
        });

        // El corazón late suave una vez que ya apareció
        if (corazon) {
            gsap.to(corazon, {
                scale: 1.18,
                duration: 0.9,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 3,
                scrollTrigger: { trigger: seccion, start: "top 82%", toggleActions: "play pause resume reset" },
            });
        }
    });
</script>
