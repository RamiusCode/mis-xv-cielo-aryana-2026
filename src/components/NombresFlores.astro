---
// Primera sección de la invitación: presentación inspirada en la referencia.
import fondoImagen from "../assets/fondo1.png";

const frase = "Mis XV años";
const nombre = "Cielo Aryana";
---

<section id="sobre-novios" class="portada-nombre" aria-label={`${frase} ${nombre}`}>
    <img class="fondo" src={fondoImagen.src} alt="" />

    <div class="texto-superior">
        <p class="frase">{frase}</p>
        <h1>{nombre}</h1>
    </div>

</section>

<style>
    .portada-nombre {
        position: relative;
        z-index: 2;
        isolation: isolate;
        width: 100%;
        aspect-ratio: 1024 / 1792;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 11% 8% 2.5%;
        color: #0b0a0d;
        text-align: center;
    }

    .fondo {
        position: absolute;
        z-index: 0;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: fill;
    }

    .texto-superior {
        position: relative;
        z-index: 2;
        align-self: center;
        width: 100%;
        max-width: 100%;
        text-align: center;
    }

    .frase {
        margin: 0 0 0.18em;
        color: #181116;
        font-family: "Ragilone Brush", cursive;
        font-size: clamp(1.65rem, 10vw, 2.8rem);
        font-weight: 400;
        line-height: 1;
        white-space: nowrap;
        transform: rotate(-3deg);
    }

    h1 {
        margin: 0;
        color: #b62d45;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: clamp(2rem, 16vw, 4.25rem);
        font-weight: 400;
        letter-spacing: -0.035em;
        line-height: 0.88;
        white-space: nowrap;
        -webkit-text-stroke: 1.2px #7f1d32;
        text-shadow: 1px 1px 0 rgba(127, 29, 50, 0.25);
    }

    @media (min-width: 700px) {
        .portada-nombre {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("sobre-novios");
        const frase = seccion?.querySelector(".frase");
        const nombre = seccion?.querySelector("h1");
        const reproductor = document.getElementById("reproductor-musical");
        if (!seccion || !frase || !nombre || !reproductor || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const entrada = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 78%",
                toggleActions: "play none none reset",
            },
        });
        entrada.fromTo(frase, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" });
        entrada.fromTo(nombre, { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" }, "-=0.3");
        entrada.fromTo(reproductor, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 1, ease: "power2.out" }, 0);
    });
</script>
