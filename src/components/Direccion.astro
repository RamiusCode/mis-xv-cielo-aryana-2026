<section class="direccion-seccion" aria-labelledby="titulo-direccion">
    <div class="tarjeta-direccion" id="tarjeta-direccion">
        <h2 id="titulo-direccion">Recepción</h2>

        <div class="pin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M19 10c0 5-7 12-7 12S5 15 5 10a7 7 0 1 1 14 0Z" />
                <circle cx="12" cy="10" r="2.4" />
            </svg>
        </div>

        <p class="salon">Salón Los Robles</p>
        <p class="calle">Calle Cañada Strongest #1822</p>
        <p class="referencia">A media cuadra de la Plaza del Estudiante</p>

        <div class="hora">
            <span class="etiqueta-hora">HORA</span>
            <span class="valor-hora">17:30</span>
        </div>

        <a
            class="boton-ubicacion"
            href="https://maps.app.goo.gl/4kHFL5KTzPnNH7H17"
            target="_blank"
            rel="noopener noreferrer"
        >
            Ver ubicación
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" />
            </svg>
        </a>
    </div>
</section>

<style>
    .direccion-seccion {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: 2.4rem 8%;
        overflow: hidden;
        background: #fff;
        color: #171518;
    }

    .tarjeta-direccion {
        position: relative;
        width: 100%;
        max-width: 23rem;
        margin: 0 auto;
        padding: 1.5rem 1.2rem 1.35rem;
        border: 1px solid #262326;
        background: #fff;
        text-align: center;
    }

    .tarjeta-direccion::before,
    .tarjeta-direccion::after {
        content: "";
        position: absolute;
        left: 50%;
        width: 2.6rem;
        height: 2px;
        background: #b72d43;
        transform: translateX(-50%);
    }

    .tarjeta-direccion::before {
        top: 0;
    }

    .tarjeta-direccion::after {
        bottom: 0;
    }

    h2 {
        margin: 0;
        color: #b72d43;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: clamp(2.5rem, 13vw, 3.6rem);
        font-weight: 400;
        letter-spacing: 0.035em;
        line-height: 1;
        text-transform: uppercase;
    }

    .pin {
        display: grid;
        place-items: center;
        margin: 0.45rem auto 0.65rem;
        color: #b72d43;
    }

    .pin svg {
        width: 1.65rem;
        height: 1.65rem;
        stroke: currentColor;
        stroke-width: 1.6;
    }

    .salon {
        margin: 0;
        color: #b72d43;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.45rem, 6vw, 1.75rem);
        font-weight: 700;
        line-height: 1.1;
    }

    .calle,
    .referencia {
        margin: 0.25rem 0 0;
        color: #454145;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1rem, 4.3vw, 1.2rem);
        font-weight: 500;
        line-height: 1.25;
    }

    .hora {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 1rem 0 0.95rem;
        padding-top: 0.7rem;
        border-top: 1px solid #dedbdd;
    }

    .etiqueta-hora {
        color: #9d263c;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: 0.95rem;
        letter-spacing: 0.16em;
    }

    .valor-hora {
        color: #171518;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: 2rem;
        line-height: 1;
    }

    .valor-hora small {
        color: #9d263c;
        font-size: 0.58em;
    }

    .boton-ubicacion {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-width: 11rem;
        padding: 0.72rem 1.2rem;
        border: 1px solid #171518;
        border-radius: 999px;
        background: #171518;
        color: #fff;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 1.05rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 180ms ease, color 180ms ease;
    }

    .boton-ubicacion svg {
        width: 1rem;
        height: 1rem;
        stroke: #df5165;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .boton-ubicacion:hover {
        background: #b72d43;
        color: #fff;
    }

    .boton-ubicacion:focus-visible {
        outline: 2px solid #b72d43;
        outline-offset: 3px;
    }

    @media (prefers-reduced-motion: reduce) {
        .boton-ubicacion {
            transition: none;
        }
    }

    @media (min-width: 700px) {
        .direccion-seccion {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const tarjeta = document.getElementById("tarjeta-direccion");
    if (tarjeta && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const entrada = gsap.timeline({
            scrollTrigger: {
                trigger: tarjeta,
                start: "top 82%",
                toggleActions: "play none none reset",
            },
        });
        entrada.fromTo(tarjeta, { opacity: 0, x: -36, y: 8, scale: 0.98 }, {
            opacity: 1, x: 0, y: 0, scale: 1, duration: 0.95, ease: "power3.out",
        });
        entrada.fromTo(tarjeta.querySelector("h2"), { opacity: 0, x: 16, y: 8 }, {
            opacity: 1, x: 0, y: 0, duration: 0.6, ease: "power2.out",
        }, 0);
        entrada.fromTo(tarjeta.querySelector(".pin"), { opacity: 0, x: -12, scale: 0.76, y: 5 }, {
            opacity: 1, x: 0, scale: 1, y: 0, duration: 0.55, ease: "back.out(1.5)",
        }, 0);
        entrada.fromTo(tarjeta.querySelectorAll(".salon, .calle, .referencia, .hora"), {
            opacity: 0, x: (index) => index % 2 === 0 ? -14 : 14, y: 7,
        }, {
            opacity: 1, x: 0, y: 0, duration: 0.55, ease: "power2.out",
        }, 0);
        entrada.fromTo(tarjeta.querySelector(".boton-ubicacion"), { opacity: 0, x: 16, y: 8, scale: 0.97 }, {
            opacity: 1, x: 0, y: 0, scale: 1, duration: 0.55, ease: "power2.out",
        }, 0);
    }
</script>
