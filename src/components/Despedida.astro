---
const espera = "Espera noticias";
const pronto = "Pronto";
const frase = "Mis XV años";
const nombre = "Cielo Aryana";

// Destellos blancos sobre la parte negra, iguales a los de la dedicatoria
// (x / y en % de la sección, t = tamaño)
const destellos = [
    { x: 7, y: 30, t: 1.3 },
    { x: 20, y: 22, t: 0.8 },
    { x: 11, y: 44, t: 0.9 },
    { x: 93, y: 28, t: 1.4 },
    { x: 80, y: 21, t: 0.8 },
    { x: 89, y: 46, t: 1 },
    { x: 5, y: 8, t: 0.7 },
    { x: 95, y: 9, t: 0.7 },
    { x: 15, y: 9, t: 0.8 },
    { x: 86, y: 10, t: 0.9 },
];

const letras = (texto: string) => Array.from(texto);
---

<section class="despedida" id="seccion-despedida" aria-label="Espera noticias pronto">
    <div class="destellos" aria-hidden="true">
        {destellos.map((d) => <span class="destello" style={`left:${d.x}%;top:${d.y}%;--t:${d.t}`} />)}
    </div>

    <div class="contenido-despedida" id="contenido-despedida">
        <p class="espera">{espera}</p>
        <h2 aria-label={pronto}>
            {
                letras(pronto).map((l) => (
                    <span class="mascara" aria-hidden="true">
                        <span class="letra-pronto">{l}</span>
                    </span>
                ))
            }
        </h2>
        <div class="adorno" aria-hidden="true">
            <span class="linea izquierda"></span>
            <span class="rombo"></span>
            <span class="linea derecha"></span>
        </div>
    </div>

    <!-- Media luna plateada de borde a borde: todo lo que va dentro queda recortado por su curva -->
    <div class="domo">
        <img class="corona-domo" src="/imagenes/corona-chica.webp" alt="" aria-hidden="true" width="640" height="314" />
        <div class="domo-recorte">
        <div class="trazo-despedida" aria-hidden="true"></div>
        <div class="texto-sello">
            <p class="sello-frase">{frase}</p>
            <p class="sello-nombre" aria-label={nombre}>
                {
                    letras(nombre).map((l) =>
                        l === " " ? (
                            <span class="espacio-nombre" aria-hidden="true" />
                        ) : (
                            <span class="letra-nombre" aria-hidden="true">
                                {l}
                            </span>
                        )
                    )
                }
            </p>
        </div>
        </div>
    </div>
</section>

<style>
    .despedida {
        position: relative;
        z-index: 2;
        isolation: isolate;
        display: grid;
        place-items: start center;
        width: 100%;
        min-height: 35rem;
        overflow: hidden;
        padding: 2.2rem 6% 0;
        background-color: #050505;
        color: #f1f2f4;
        text-align: center;
    }

    .contenido-despedida {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    /* "Espera noticias" en letra cursiva, como "Confirmación de" */
    .espera {
        margin: 0;
        color: #c9ccd2;
        font-family: "Ragilone Brush", cursive;
        font-size: clamp(1.9rem, 9.5vw, 2.7rem);
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.05;
        white-space: nowrap;
    }

    .espacio,
    .espacio-nombre {
        display: inline-block;
        width: 0.3em;
    }

    h2 {
        margin: -0.04em 0 0;
        color: #fff;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: clamp(3.3rem, 18vw, 5rem);
        font-weight: 400;
        letter-spacing: 0.02em;
        line-height: 0.88;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .mascara {
        display: inline-block;
        overflow: hidden;
        vertical-align: top;
        padding-top: 0.04em;
    }

    .letra-pronto {
        display: inline-block;
    }

    /* Adorno: dos líneas plateadas y un rombo rojo */
    .adorno {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 55%;
        margin: 0.9rem auto 0;
    }

    .linea {
        flex: 1;
        height: 1px;
        background: #c9ccd2;
    }

    .linea.izquierda {
        transform-origin: right center;
    }

    .linea.derecha {
        transform-origin: left center;
    }

    .rombo {
        width: 0.5rem;
        aspect-ratio: 1;
        rotate: 45deg;
        background: #d5283f;
    }

    /* Media luna plateada: ocupa todo el ancho y apoya su base en el borde de abajo */
    .domo {
        position: absolute;
        z-index: 2;
        left: 50%;
        bottom: 0;
        width: 164%;
        aspect-ratio: 2 / 1;
        transform: translateX(-50%);
    }

    /* La media luna propiamente dicha: acá se recorta todo lo que va dentro */
    .domo-recorte {
        position: absolute;
        inset: 0;
        overflow: hidden;
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
        background-color: #c9ccd2;
    }

    /* Corona plateada con rubíes, apoyada sobre el punto más alto */
    .corona-domo {
        position: absolute;
        z-index: 5;
        top: -2.7rem;
        left: 50%;
        width: 8.6rem;
        height: auto;
        translate: -50% 0;
        filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.45));
        pointer-events: none;
    }

    /* Línea fina oscura por dentro del borde */
    .domo-recorte::before {
        content: "";
        position: absolute;
        inset: 0.7rem 0.7rem 0;
        border: 1px solid rgba(17, 17, 17, 0.35);
        border-bottom: 0;
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
        pointer-events: none;
    }

    .texto-sello {
        position: absolute;
        z-index: 4;
        top: 10%;
        left: 0;
        right: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 0.75rem;
    }

    .sello-frase {
        margin: 0 0 0.2rem;
        color: #b3122e;
        font-family: "Ragilone Brush", cursive;
        font-size: clamp(1.55rem, 7.5vw, 2.15rem);
        line-height: 1;
    }

    .sello-nombre {
        margin: 0;
        color: #0d0d0f;
        font-family: "Bebas Neue", Impact, sans-serif;
        font-size: clamp(2.8rem, 14vw, 4.3rem);
        line-height: 0.95;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .letra-nombre {
        display: inline-block;
    }

    /* Ciudad dibujada en líneas negras sobre el plateado */
    .trazo-despedida {
        position: absolute;
        z-index: 3;
        left: 50%;
        bottom: -0.3rem;
        width: 38%;
        aspect-ratio: 1015 / 715;
        transform: translateX(-50%);
        background-color: #111;
        opacity: 0.9;
        -webkit-mask: url("/imagenes/trazo.png") center / 100% 100% no-repeat;
        mask: url("/imagenes/trazo.png") center / 100% 100% no-repeat;
        pointer-events: none;
    }

    .destellos {
        position: absolute;
        z-index: 1;
        inset: 0;
        pointer-events: none;
        filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.65));
    }

    .destello {
        position: absolute;
        width: calc(0.95rem * var(--t));
        aspect-ratio: 1;
        translate: -50% -50%;
        background: #fff;
        clip-path: polygon(50% 0, 59% 41%, 100% 50%, 59% 59%, 50% 100%, 41% 59%, 0 50%, 41% 41%);
        opacity: 0.9;
    }

    @media (min-width: 700px) {
        .despedida {
            max-width: 31.5rem;
            margin-inline: auto;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const seccion = document.getElementById("seccion-despedida");
    const contenido = document.getElementById("contenido-despedida");

    if (seccion && contenido && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const espera = contenido.querySelector(".espera");
        const letrasPronto = contenido.querySelectorAll(".letra-pronto");
        const lineas = contenido.querySelectorAll(".linea");
        const rombo = contenido.querySelector(".rombo");
        const domo = seccion.querySelector(".domo");
        const corona = seccion.querySelector(".corona-domo");
        const trazo = seccion.querySelector(".trazo-despedida");
        const frase = seccion.querySelector(".sello-frase");
        const letrasNombre = seccion.querySelectorAll(".letra-nombre");
        const textoSello = seccion.querySelector(".texto-sello");
        const destellos = seccion.querySelectorAll(".destello");

        // Los destellos titilan solos, cada uno a su ritmo
        let titilando = false;
        const titilar = () => {
            if (titilando) return;
            titilando = true;
            destellos.forEach((d) => {
                gsap.timeline({ repeat: -1, delay: gsap.utils.random(0, 2), repeatDelay: gsap.utils.random(0.2, 1.4) })
                    .to(d, { scale: 1.25, opacity: 1, rotate: 20, duration: 0.7, ease: "sine.inOut" })
                    .to(d, { scale: 0.35, opacity: 0.25, rotate: 0, duration: 0.9, ease: "sine.inOut" });
            });
        };

        const entrada = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 70%",
                toggleActions: "play none none reset",
            },
            onStart: titilar,
        });

        // "Espera noticias": se escribe de izquierda a derecha
        entrada.fromTo(
            espera,
            { clipPath: "inset(-20% 100% -20% 0%)" },
            { clipPath: "inset(-20% 0% -20% 0%)", duration: 1.2, ease: "power2.inOut" },
            0
        );

        // "PRONTO": cada letra sube desde una máscara
        entrada.fromTo(letrasPronto, { yPercent: 115 }, { yPercent: 0, duration: 0.9, ease: "power3.out", stagger: 0.07 }, 0.5);

        // Líneas y rombo
        entrada.fromTo(lineas, { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "power2.out" }, 1.2);
        entrada.fromTo(rombo, { scale: 0 }, { scale: 1, duration: 0.6, ease: "back.out(2.5)" }, 1.35);

        // Destellos
        entrada.fromTo(destellos, { opacity: 0, scale: 0 }, { opacity: 0.9, scale: 1, duration: 0.8, ease: "back.out(2)", stagger: 0.08 }, 1.0);

        // Media luna: sube desde abajo hasta apoyarse en el borde
        if (domo) {
            entrada.fromTo(domo, { yPercent: 100 }, { yPercent: 0, duration: 1.5, ease: "power3.out" }, 1.2);
        }
        // Corona: baja y se posa sobre la media luna
        if (corona) {
            entrada.fromTo(
                corona,
                { y: -34, opacity: 0, scale: 0.75, rotation: -5 },
                { y: 0, opacity: 1, scale: 1, rotation: 0, duration: 1.3, ease: "back.out(1.6)" },
                2.5
            );
        }

        // Ciudad: se descubre de abajo hacia arriba dentro de la media luna
        if (trazo) {
            entrada.fromTo(
                trazo,
                { clipPath: "inset(100% 0% 0% 0%)" },
                { clipPath: "inset(0% 0% 0% 0%)", duration: 2.2, ease: "power2.out" },
                2.0
            );
        }

        // "Mis XV años" se escribe y el nombre entra letra por letra desde los lados
        if (frase) {
            entrada.fromTo(
                frase,
                { clipPath: "inset(-20% 100% -20% 0%)" },
                { clipPath: "inset(-20% 0% -20% 0%)", duration: 1, ease: "power2.inOut" },
                2.6
            );
        }
        entrada.fromTo(
            letrasNombre,
            { opacity: 0, x: (i) => (i % 2 === 0 ? -34 : 34) },
            { opacity: 1, x: 0, duration: 0.9, ease: "power2.out", stagger: 0.05 },
            2.9
        );

        // PARALLAX: los textos y la ciudad se mueven a distinta velocidad
        // (la media luna no se mueve, para que su base siempre toque el borde de abajo)
        const parallax = (objetivo: Element | null, desde: number, hasta: number) => {
            if (!objetivo) return;
            gsap.fromTo(
                objetivo,
                { yPercent: desde },
                { yPercent: hasta, ease: "none", scrollTrigger: { trigger: seccion, start: "top bottom", end: "bottom top", scrub: 0.6 } }
            );
        };
        parallax(contenido, 4, -4);
        parallax(trazo, 5, -2);
        parallax(textoSello, 3, -5);
    }
</script>
